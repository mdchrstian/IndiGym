digraph { graph [bgcolor="white", pad="0.15", nodesep="0.35", ranksep="0.55", splines="polyline"]; node [shape="plain", fontname="Arial", fontsize="12"]; edge [fontname="Arial", fontsize="10", color="#475569", arrowsize="0.8"];
 node [fontsize="11"];
 akun [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#64748b"><TR><TD BGCOLOR="#e8eef4"><B>akun_admin</B></TD></TR><TR><TD ALIGN="LEFT">PK id | UK username</TD></TR><TR><TD ALIGN="LEFT">nama, kontak, password_hash</TD></TR><TR><TD ALIGN="LEFT">role, aktif, session_version</TD></TR></TABLE>>];
 pelanggan [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#64748b"><TR><TD BGCOLOR="#e8eef4"><B>pelanggan</B></TD></TR><TR><TD ALIGN="LEFT">PK id | UK kode_pelanggan</TD></TR><TR><TD ALIGN="LEFT">nama, kontak NULL</TD></TR><TR><TD ALIGN="LEFT">diarsipkan, created_at</TD></TR></TABLE>>];
 paket [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#64748b"><TR><TD BGCOLOR="#e8eef4"><B>paket_akses</B></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">nama, jenis, harga</TD></TR><TR><TD ALIGN="LEFT">durasi_bulan NULL, diarsipkan</TD></TR></TABLE>>];
 bayar [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#64748b"><TR><TD BGCOLOR="#e8eef4"><B>pembayaran_akses</B></TD></TR><TR><TD ALIGN="LEFT">PK id | UK request_id</TD></TR><TR><TD ALIGN="LEFT">FK pelanggan_id, paket_id</TD></TR><TR><TD ALIGN="LEFT">FK admin_id, dibatalkan_oleh NULL</TD></TR><TR><TD ALIGN="LEFT">snapshot nama, jenis, harga, durasi</TD></TR><TR><TD ALIGN="LEFT">tanggal_bayar, jumlah_bayar, status</TD></TR><TR><TD ALIGN="LEFT">dibatalkan_pada NULL, alasan NULL</TD></TR></TABLE>>];
 hak [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#64748b"><TR><TD BGCOLOR="#e8eef4"><B>hak_akses</B></TD></TR><TR><TD ALIGN="LEFT">PK id | UK FK pembayaran_id</TD></TR><TR><TD ALIGN="LEFT">tanggal_mulai</TD></TR><TR><TD ALIGN="LEFT">tanggal_terakhir_berlaku</TD></TR></TABLE>>];
 checkin [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#64748b"><TR><TD BGCOLOR="#e8eef4"><B>checkin</B></TD></TR><TR><TD ALIGN="LEFT">PK id | UK request_id</TD></TR><TR><TD ALIGN="LEFT">FK pelanggan_id, admin_id</TD></TR><TR><TD ALIGN="LEFT">FK hak_akses_id NULL</TD></TR><TR><TD ALIGN="LEFT">waktu_utc, hasil, alasan</TD></TR></TABLE>>];
 akun -> bayar [label="1 : N petugas"]; pelanggan -> bayar [label="1 : N"]; paket -> bayar [label="1 : N"];
 bayar -> hak [label="1 : 1"]; pelanggan -> checkin [label="1 : N"]; akun -> checkin [label="1 : N petugas"]; hak -> checkin [label="0..1 : N"];
 {rank=same; akun; pelanggan; paket;}
}