<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox minWidth="210" prefWidth="210" styleClass="navigasi" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="id.indigym.controller.NavigasiController">
    <HBox>
        <Label styleClass="logo" text="indigym" />
        <Label styleClass="logo-kursor" text="_" />
    </HBox>
    <Label styleClass="label-bagian" text="ADMINISTRASI GYM" />
    <Region minHeight="18" />
    <Region styleClass="garis-putus" />
    <Region minHeight="10" />

    <Button fx:id="tombolBeranda" maxWidth="Infinity" onAction="#bukaBeranda" styleClass="tombol-navigasi" text="Beranda" />
    <Button fx:id="tombolPelanggan" maxWidth="Infinity" onAction="#bukaPelanggan" styleClass="tombol-navigasi" text="Pelanggan" />
    <Button fx:id="tombolAkses" maxWidth="Infinity" onAction="#bukaAkses" styleClass="tombol-navigasi" text="Membership" />
    <Button fx:id="tombolPenjualan" maxWidth="Infinity" onAction="#bukaPenjualan" styleClass="tombol-navigasi" text="Kasir dan produk" />
    <Button fx:id="tombolAkun" maxWidth="Infinity" onAction="#bukaAkun" styleClass="tombol-navigasi" text="Akun" />

    <Region VBox.vgrow="ALWAYS" />
    <Region styleClass="garis-putus" />
    <Region minHeight="10" />
    <Label styleClass="label-bagian" text="MASUK SEBAGAI" />
    <Label fx:id="labelPetugas" styleClass="judul-kartu" wrapText="true" />
    <Label fx:id="labelPeran" styleClass="label-atas" />
    <Region minHeight="8" />
    <Button maxWidth="Infinity" onAction="#keluar" text="Keluar" />
</VBox>