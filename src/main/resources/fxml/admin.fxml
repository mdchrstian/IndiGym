<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="id.indigym.controller.AdminController">
    <left>
        <fx:include source="navigasi.fxml" />
    </left>
    <center>
        <VBox styleClass="isi-layar">
            <Label styleClass="label-atas" text="INDIGYM / AKUN" />
            <Label styleClass="judul" text="Akun petugas" />
            <Label fx:id="labelKeterangan" styleClass="teks-redup" />
            <Label fx:id="labelPesan" managed="false" minHeight="-Infinity" styleClass="pesan" visible="false" wrapText="true" />

            <HBox spacing="16" VBox.vgrow="ALWAYS">
                <VBox maxHeight="-Infinity" minWidth="320" prefWidth="340" spacing="10" styleClass="panel">
                    <Label styleClass="label-bagian" text="AKUN SAYA" />
                    <Label fx:id="labelNamaSaya" styleClass="judul-sedang" />
                    <Label fx:id="labelInfoSaya" styleClass="teks-mono, teks-redup" />
                    <Region styleClass="garis-putus" />
                    <Label styleClass="label-bagian" text="GANTI PASSWORD" />
                    <PasswordField fx:id="fieldPasswordLama" promptText="Password lama" />
                    <PasswordField fx:id="fieldPasswordBaru" promptText="Password baru (minimal 6 karakter)" />
                    <PasswordField fx:id="fieldPasswordUlang" onAction="#gantiPasswordSendiri" promptText="Ulangi password baru" />
                    <Button maxWidth="Infinity" onAction="#gantiPasswordSendiri" styleClass="tombol-utama" text="Ganti password" />
                </VBox>

                <VBox fx:id="kotakKelola" spacing="10" HBox.hgrow="ALWAYS">
                    <Label styleClass="label-bagian" text="KELOLA AKUN ADMIN" />
                    <TableView fx:id="tabelAdmin" onKeyReleased="#pilihAdmin" onMouseClicked="#pilihAdmin" VBox.vgrow="ALWAYS">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" /></columnResizePolicy>
                        <placeholder><Label text="Belum ada akun." /></placeholder>
                        <columns>
                            <TableColumn prefWidth="180" text="Nama">
                                <cellValueFactory><PropertyValueFactory property="nama" /></cellValueFactory>
                            </TableColumn>
                            <TableColumn prefWidth="130" styleClass="kolom-mono" text="Username">
                                <cellValueFactory><PropertyValueFactory property="username" /></cellValueFactory>
                            </TableColumn>
                            <TableColumn prefWidth="110" styleClass="kolom-mono" text="Peran">
                                <cellValueFactory><PropertyValueFactory property="role" /></cellValueFactory>
                            </TableColumn>
                            <TableColumn prefWidth="90" styleClass="kolom-mono" text="Status">
                                <cellValueFactory><PropertyValueFactory property="status" /></cellValueFactory>
                            </TableColumn>
                        </columns>
                    </TableView>

                    <Label fx:id="labelAdminTerpilih" styleClass="label-bagian" text="ADMIN TERPILIH: BELUM ADA (KLIK BARIS DI TABEL)" />
                    <HBox spacing="8">
                        <PasswordField fx:id="fieldPasswordReset" promptText="Password baru untuk admin terpilih" HBox.hgrow="ALWAYS" />
                        <Button minWidth="-Infinity" fx:id="tombolReset" disable="true" onAction="#resetPassword" text="Reset password" />
                        <Button minWidth="-Infinity" fx:id="tombolNonaktif" disable="true" onAction="#nonaktifkanAdmin" styleClass="tombol-bahaya" text="Nonaktifkan" />
                    </HBox>

                    <Region styleClass="garis-putus" />
                    <Label styleClass="label-bagian" text="TAMBAH ADMIN BARU" />
                    <HBox spacing="8">
                        <TextField fx:id="fieldNamaBaru" promptText="Nama" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="fieldUsernameBaru" promptText="Username" styleClass="kolom-cari" />
                        <PasswordField fx:id="fieldPasswordAdminBaru" promptText="Password (min. 6)" />
                        <Button minWidth="-Infinity" onAction="#tambahAdmin" text="Tambah admin" />
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>