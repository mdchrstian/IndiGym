<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="id.indigym.controller.AdminController">
    <left>
        <fx:include source="navigasi.fxml" />
    </left>
    <center>
        <VBox styleClass="isi-layar">
            <VBox spacing="4">
                <Label styleClass="judul" text="Akun" />
                <Label fx:id="labelKeterangan" styleClass="subjudul" />
            </VBox>
            <Label fx:id="labelPesan" managed="false" minHeight="-Infinity" styleClass="pesan" visible="false" wrapText="true" />

            <HBox spacing="24" VBox.vgrow="ALWAYS">
                <VBox maxHeight="-Infinity" minWidth="300" prefWidth="340" styleClass="panel">
                    <VBox spacing="4">
                        <Label fx:id="labelNamaSaya" styleClass="judul-kartu" />
                        <Label fx:id="labelInfoSaya" styleClass="teks-meta" />
                    </VBox>
                    <Region styleClass="garis-putus" />
                    <Label styleClass="label-bagian" text="Ganti password" />
                    <PasswordField fx:id="fieldPasswordLama" promptText="Password lama" />
                    <PasswordField fx:id="fieldPasswordBaru" promptText="Password baru (minimal 6 karakter)" />
                    <PasswordField fx:id="fieldPasswordUlang" onAction="#gantiPasswordSendiri" promptText="Ulangi password baru" />
                    <Button maxWidth="Infinity" onAction="#gantiPasswordSendiri" styleClass="tombol-utama" text="Ganti password" />
                </VBox>

                <VBox fx:id="kotakKelola" spacing="16" HBox.hgrow="ALWAYS">
                    <TableView fx:id="tabelAdmin" onKeyReleased="#pilihAdmin" onMouseClicked="#pilihAdmin" VBox.vgrow="ALWAYS">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" /></columnResizePolicy>
                        <placeholder><Label text="Belum ada akun." /></placeholder>
                        <columns>
                            <TableColumn prefWidth="180" text="Nama">
                                <cellValueFactory><PropertyValueFactory property="nama" /></cellValueFactory>
                            </TableColumn>
                            <TableColumn prefWidth="130" styleClass="kolom-mono" text="Username">
                                <cellValueFactory><PropertyValueFactory property="username" /></cellValueFactory>
                            </TableColumn>
                            <TableColumn prefWidth="110" text="Peran">
                                <cellValueFactory><PropertyValueFactory property="role" /></cellValueFactory>
                            </TableColumn>
                            <TableColumn prefWidth="90" text="Status">
                                <cellValueFactory><PropertyValueFactory property="status" /></cellValueFactory>
                            </TableColumn>
                        </columns>
                    </TableView>

                    <VBox styleClass="panel">
                        <Label fx:id="labelAdminTerpilih" minHeight="-Infinity" styleClass="label-bagian" text="Pilih akun di tabel untuk reset password atau menonaktifkan." wrapText="true" />
                        <HBox spacing="8">
                            <PasswordField fx:id="fieldPasswordReset" promptText="Password baru untuk admin terpilih" HBox.hgrow="ALWAYS" />
                            <Button fx:id="tombolReset" disable="true" minWidth="-Infinity" onAction="#resetPassword" text="Reset password" />
                            <Button fx:id="tombolNonaktif" disable="true" minWidth="-Infinity" onAction="#nonaktifkanAdmin" styleClass="tombol-bahaya" text="Nonaktifkan" />
                        </HBox>
                    </VBox>

                    <VBox styleClass="panel">
                        <Label styleClass="label-bagian" text="Tambah admin" />
                        <HBox spacing="8">
                            <TextField fx:id="fieldNamaBaru" promptText="Nama" HBox.hgrow="ALWAYS" />
                            <TextField fx:id="fieldUsernameBaru" prefWidth="150" promptText="Username" />
                            <PasswordField fx:id="fieldPasswordAdminBaru" prefWidth="160" promptText="Password (min. 6)" />
                            <Button minWidth="-Infinity" onAction="#tambahAdmin" styleClass="tombol-utama" text="Tambah admin" />
                        </HBox>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
