<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="id.indigym.controller.PenjualanController">
    <left>
        <fx:include source="navigasi.fxml" />
    </left>
    <center>
        <VBox styleClass="isi-layar">
            <VBox spacing="4">
                <Label styleClass="judul" text="Kasir dan produk" />
                <Label styleClass="subjudul" text="Klik dua kali produk untuk memasukkannya ke keranjang" />
            </VBox>
            <Label fx:id="labelPesan" managed="false" minHeight="-Infinity" styleClass="pesan" visible="false" wrapText="true" />

            <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                <tabs>
                    <!-- ===== KASIR ===== -->
                    <Tab text="Kasir">
                        <HBox spacing="24">
                            <VBox spacing="16" HBox.hgrow="ALWAYS">
                                <StackPane alignment="CENTER_LEFT">
                                    <TextField fx:id="fieldCariKasir" onKeyReleased="#cariProduk" promptText="Nama atau kode produk" styleClass="kolom-cari" />
                                    <Group mouseTransparent="true" StackPane.alignment="CENTER_LEFT">
                                        <StackPane.margin><Insets left="12" /></StackPane.margin>
                                        <SVGPath content="M4 11a7 7 0 1 0 14 0a7 7 0 1 0 -14 0M20.5 20.5L16 16" scaleX="0.75" scaleY="0.75" styleClass="ikon" />
                                    </Group>
                                </StackPane>
                                <TableView fx:id="tabelProdukKasir" onMouseClicked="#klikProdukKasir" VBox.vgrow="ALWAYS">
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" /></columnResizePolicy>
                                    <placeholder><Label text="Tidak ada produk yang cocok." /></placeholder>
                                    <columns>
                                        <TableColumn prefWidth="90" styleClass="kolom-mono" text="Kode">
                                            <cellValueFactory><PropertyValueFactory property="kode" /></cellValueFactory>
                                        </TableColumn>
                                        <TableColumn prefWidth="200" text="Produk">
                                            <cellValueFactory><PropertyValueFactory property="nama" /></cellValueFactory>
                                        </TableColumn>
                                        <TableColumn prefWidth="110" styleClass="kolom-angka" text="Harga">
                                            <cellValueFactory><PropertyValueFactory property="hargaTeks" /></cellValueFactory>
                                        </TableColumn>
                                        <TableColumn prefWidth="70" styleClass="kolom-angka" text="Stok">
                                            <cellValueFactory><PropertyValueFactory property="stok" /></cellValueFactory>
                                        </TableColumn>
                                    </columns>
                                </TableView>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label styleClass="label-bagian" text="Jumlah" />
                                    <TextField fx:id="fieldJumlah" onAction="#tambahKeKeranjang" prefWidth="64" styleClass="teks-mono" text="1" />
                                    <Button minWidth="-Infinity" onAction="#tambahKeKeranjang" text="Tambah ke keranjang">
                                        <graphic><StackPane styleClass="kotak-ikon"><Group><SVGPath content="M12 5v14M5 12h14" scaleX="0.67" scaleY="0.67" styleClass="ikon" /></Group></StackPane></graphic>
                                    </Button>
                                    <Label styleClass="teks-meta" text="atau klik dua kali produk" />
                                </HBox>
                            </VBox>

                            <VBox minWidth="360" prefWidth="390" styleClass="panel">
                                <Label styleClass="judul-kartu" text="Keranjang" />
                                <TableView fx:id="tabelKeranjang" VBox.vgrow="ALWAYS">
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" /></columnResizePolicy>
                                    <placeholder><Label text="Keranjang kosong." /></placeholder>
                                    <columns>
                                        <TableColumn prefWidth="150" text="Produk">
                                            <cellValueFactory><PropertyValueFactory property="namaProduk" /></cellValueFactory>
                                        </TableColumn>
                                        <TableColumn prefWidth="50" styleClass="kolom-angka" text="Jml">
                                            <cellValueFactory><PropertyValueFactory property="jumlah" /></cellValueFactory>
                                        </TableColumn>
                                        <TableColumn prefWidth="130" styleClass="kolom-angka" text="Subtotal">
                                            <cellValueFactory><PropertyValueFactory property="subtotalTeks" /></cellValueFactory>
                                        </TableColumn>
                                    </columns>
                                </TableView>
                                <HBox spacing="8">
                                    <Button minWidth="-Infinity" onAction="#hapusDariKeranjang" text="Hapus" />
                                    <Button minWidth="-Infinity" onAction="#kosongkanKeranjang" text="Kosongkan" />
                                </HBox>
                                <VBox spacing="8">
                                    <Label styleClass="label-bagian" text="Kode pelanggan (boleh kosong)" />
                                    <TextField fx:id="fieldKodePelanggan" promptText="Kosongkan untuk pembeli umum" />
                                </VBox>
                                <Region styleClass="garis-putus" />
                                <HBox alignment="BASELINE_LEFT">
                                    <Label styleClass="teks-redup" text="Total" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="labelTotal" styleClass="angka-besar" text="Rp 0" />
                                </HBox>
                                <Button fx:id="tombolCheckout" maxWidth="Infinity" onAction="#checkout" styleClass="tombol-transaksi, tombol-besar" text="Bayar" />
                            </VBox>
                        </HBox>
                    </Tab>

                    <Tab text="Produk dan stok">
                        <VBox spacing="16">
                            <TableView fx:id="tabelProdukKelola" onKeyReleased="#pilihProdukKelola" onMouseClicked="#pilihProdukKelola" VBox.vgrow="ALWAYS">
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" /></columnResizePolicy>
                                <placeholder><Label text="Belum ada produk." /></placeholder>
                                <columns>
                                    <TableColumn prefWidth="110" styleClass="kolom-mono" text="Kode">
                                        <cellValueFactory><PropertyValueFactory property="kode" /></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn prefWidth="280" text="Produk">
                                        <cellValueFactory><PropertyValueFactory property="nama" /></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn prefWidth="140" styleClass="kolom-angka" text="Harga">
                                        <cellValueFactory><PropertyValueFactory property="hargaTeks" /></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn prefWidth="90" styleClass="kolom-angka" text="Stok">
                                        <cellValueFactory><PropertyValueFactory property="stok" /></cellValueFactory>
                                    </TableColumn>
                                </columns>
                            </TableView>

                            <VBox styleClass="panel">
                                <Label fx:id="labelProdukTerpilih" styleClass="label-bagian" text="Pilih produk di tabel untuk mengubahnya." />
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <TextField fx:id="fieldNamaProduk" promptText="Nama" HBox.hgrow="ALWAYS" />
                                    <TextField fx:id="fieldHargaProduk" prefWidth="140" promptText="Harga" />
                                    <Button fx:id="tombolSimpanProduk" disable="true" minWidth="-Infinity" onAction="#simpanPerubahanProduk" text="Simpan" />
                                    <Region minWidth="8" />
                                    <TextField fx:id="fieldTambahStok" prefWidth="112" promptText="Stok masuk" />
                                    <Button fx:id="tombolTambahStok" disable="true" minWidth="-Infinity" onAction="#tambahStok" text="Tambah stok" />
                                    <Button fx:id="tombolArsipProduk" disable="true" minWidth="-Infinity" onAction="#arsipkanProduk" styleClass="tombol-bahaya" text="Arsipkan" />
                                </HBox>
                            </VBox>

                            <VBox styleClass="panel">
                                <Label styleClass="label-bagian" text="Tambah produk" />
                                <HBox spacing="8">
                                    <TextField fx:id="fieldKodeProduk" prefWidth="120" promptText="Kode" />
                                    <TextField fx:id="fieldNamaProdukBaru" promptText="Nama" HBox.hgrow="ALWAYS" />
                                    <TextField fx:id="fieldHargaProdukBaru" prefWidth="140" promptText="Harga" />
                                    <TextField fx:id="fieldStokAwal" prefWidth="104" promptText="Stok awal" />
                                    <Button minWidth="-Infinity" onAction="#tambahProduk" styleClass="tombol-utama" text="Tambah produk" />
                                </HBox>
                            </VBox>
                        </VBox>
                    </Tab>

                    <Tab text="Riwayat penjualan">
                        <VBox spacing="16">
                            <TableView fx:id="tabelRiwayat" onMouseClicked="#klikRiwayat" VBox.vgrow="ALWAYS">
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" /></columnResizePolicy>
                                <placeholder><Label text="Belum ada penjualan." /></placeholder>
                                <columns>
                                    <TableColumn prefWidth="60" styleClass="kolom-mono" text="No.">
                                        <cellValueFactory><PropertyValueFactory property="id" /></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn prefWidth="150" styleClass="kolom-mono" text="Waktu">
                                        <cellValueFactory><PropertyValueFactory property="waktuTeks" /></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn prefWidth="230" text="Pembeli">
                                        <cellValueFactory><PropertyValueFactory property="namaPelanggan" /></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn prefWidth="130" styleClass="kolom-angka" text="Total">
                                        <cellValueFactory><PropertyValueFactory property="totalTeks" /></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn prefWidth="90" text="Status">
                                        <cellValueFactory><PropertyValueFactory property="status" /></cellValueFactory>
                                    </TableColumn>
                                </columns>
                            </TableView>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Button minWidth="-Infinity" onAction="#lihatStruk" text="Lihat struk" />
                                <Label styleClass="teks-meta" text="atau klik dua kali transaksi" />
                                <Region HBox.hgrow="ALWAYS" />
                                <TextField fx:id="fieldAlasanBatal" prefWidth="280" promptText="Alasan pembatalan (wajib)" />
                                <Button minWidth="-Infinity" onAction="#batalkanTransaksi" styleClass="tombol-bahaya" text="Batalkan transaksi" />
                            </HBox>
                        </VBox>
                    </Tab>
                </tabs>
            </TabPane>
        </VBox>
    </center>
</BorderPane>
