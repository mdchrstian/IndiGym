<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

         <modelVersion>4.0.0</modelVersion>

         <groupId>id.indigym</groupId>
         <artifactId>indigym</artifactId>
         <version>1.0-SNAPSHOT</version>

         <properties>
            <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
            <!-- Versi Java Yang Digunakan-->
            <maven.compiler.release>25</maven.compiler.release>
            <javafx.version>27</javafx.version>
         </properties>

         <dependencies>
            <!--Komponen Utama dari JavaFX-->
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-controls</artifactId>
                <version>${javafx.version}</version>

            </dependency>
            <!--Dukungan FXML-->
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-fxml</artifactId>
                <version>${javafx.version}</version>
            </dependency>
         </dependencies>

         <build>
            <plugins>
         <!--Compiler Java-->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <!--Menjalankan Aplikasi JavaFX-->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>id.indigym.MainApp</mainClass>
                </configuration>
            </plugin>
            </plugins>
         </build>
</project>
